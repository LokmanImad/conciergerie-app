# Server only. Copy to .env.local (ignored by Git).
# Obtain the outgoing server from cPanel > Email Accounts > Connect Devices.
# Use the exact hostname listed under Secure SSL/TLS Settings, not the website URL.
SMTP_HOST=
# 465: SMTP_SECURE=true (implicit TLS).
# 587: SMTP_SECURE=false (STARTTLS is required by the server code).
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@asadhospitality.ma
# Mailbox password, NOT your cPanel password. Never commit it or share it in chat.
# In .env.local, quote it if it includes # or spaces; use a compatible quote type.
# In Vercel, enter the raw password without wrapping quotes.
SMTP_PASSWORD=
# Single plain addresses only. The sender must be authorized by your mail server.
CONTACT_FROM_EMAIL=info@asadhospitality.ma
CONTACT_TO_EMAIL=info@asadhospitality.ma
# Optional public contact details, inserted at build time.
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_WHATSAPP_NUMBER=
